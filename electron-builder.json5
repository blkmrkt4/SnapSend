{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.liquidrelay.app",
  "productName": "Liquid Relay",
  "npmRebuild": true,
  "buildDependenciesFromSource": true,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron-dist/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron-dist/main.js"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.utilities",
    "icon": "assets/icon.png",
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "entitlements": "assets/entitlements.mac.plist",
    "entitlementsInherit": "assets/entitlements.mac.plist",
    "notarize": true,
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "Liquid Relay uses the local network to discover and transfer files to other devices.",
      "NSBonjourServices": ["_liquidrelay._tcp"]
    }
  },
  "dmg": {
    // Version-less filename so the website can link to GitHub's
    // `releases/latest/download/<file>` redirector and never need updating.
    // The version is still visible inside the .dmg (Info.plist) and on the
    // release page itself.
    "artifactName": "LiquidRelay-Mac-${arch}.${ext}",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "assets/icon.png"
  },
  "nsis": {
    "artifactName": "LiquidRelaySetup.${ext}",
    "oneClick": false,
    "perMachine": true,
    "deleteAppDataOnUninstall": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    // Install-time firewall registration — adds rules under the elevation
    // Windows already requested for the installer. Means the user never sees
    // a separate UAC prompt at runtime, even on locked-down corporate PCs
    // where the IT admin enters credentials once at install.
    // Path is resolved relative to buildResourcesDir (default: ./build/).
    "include": "installer.nsh"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Utility"
  }
}
